# Ignore the Dockerfile itself
Dockerfile
.dockerignore

# Ignore Git files
.git
.gitignore

# Ignore Composer files that are only needed locally
composer.lock
vendor/

# Ignore Node files
node_modules/
npm-debug.log
yarn-error.log
pnpm-lock.yaml

# Ignore Laravel specific files
.env
.env.*
.phpunit.result.cache
storage/*.key
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
storage/logs/*
bootstrap/cache/*

# Ignore IDE/editor files
*.swp
*.swo
*.idea/
*.vscode/
*.DS_Store

# Ignore test and documentation files
tests/
docs/

# Ignore other local files
*.log
